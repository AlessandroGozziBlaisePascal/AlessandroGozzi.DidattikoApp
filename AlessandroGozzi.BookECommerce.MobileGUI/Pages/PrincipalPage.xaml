<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AlessandroGozzi.BookECommerce.MobileGUI.ViewModels"
             x:Class="AlessandroGozzi.BookECommerce.MobileGUI.Pages.PrincipalPage"
             x:DataType="vm:PrincipalViewModel"
             Shell.NavBarIsVisible="False">

    <Grid IgnoreSafeArea="True">
        <!-- Sfondo coordinato con gradiente fluido viola-blu -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4A148C" Offset="0.0" />
                <GradientStop Color="#5B21B6" Offset="0.35" />
                <GradientStop Color="#1D4ED8" Offset="0.75" />
                <GradientStop Color="#2563EB" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,50,20,35">

                <!-- 1. HEADER DI BENVENUTO (Senza freccia laterale) -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#40FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF"
                        Padding="22,16">
                    <Border.Shadow>
                        <Shadow Brush="#30000000" Offset="0,4" Radius="10" Opacity="0.5" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Benvenuto nell'Hub Didattiko" FontSize="13" TextColor="#E2E8F0" />
                            <Label Text="{Binding CustomerFullName}" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </VerticalStackLayout>

                        <!-- Logo a destra -->
                        <Image Grid.Column="1" Source="LogoDidattiko.png" HeightRequest="46" WidthRequest="46" Aspect="AspectFit" />
                    </Grid>
                </Border>

                <!-- 2. MENU A TENDINA: METODI DI PAGAMENTO (Sfondo coordinato all'header) -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#40FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#30000000" Offset="0,6" Radius="14" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout>
                        <!-- Intestazione Cliccabile della Tendina -->
                        <Grid ColumnDefinitions="*, Auto" Padding="20,16" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCardSectionCommand}" />
                            </Grid.GestureRecognizers>

                            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                <Label Text="💳" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Metodi di Pagamento / Aggiungi Carta"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Grid.Column="1"
                                   Text="{Binding AccordionIcon}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Contenuto Espandibile -->
                        <VerticalStackLayout IsVisible="{Binding IsCardSectionExpanded}"
                                             Padding="18,0,18,20"
                                             Spacing="14">

                            <BoxView HeightRequest="1" Color="#40FFFFFF" Margin="0,0,0,6" />

                            <!-- MOCK DELLA CARTA -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="230"
                                    StrokeThickness="0"
                                    Padding="18,14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#D97706" Offset="0.0" />
                                        <GradientStop Color="#F59E0B" Offset="0.5" />
                                        <GradientStop Color="#B45309" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow Brush="#30000000" Offset="0,4" Radius="8" Opacity="0.5" />
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="12">
                                    <!-- RIGA 1: Titolo Carta e Chip -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="DIDATTIKO CARD" TextColor="#FEF3C7" FontSize="12" FontAttributes="Bold" CharacterSpacing="2" />
                                        <Border Grid.Column="1" WidthRequest="36" HeightRequest="26" StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#FDE68A" Stroke="#B45309" StrokeThickness="1" />
                                    </Grid>

                                    <!-- RIGA 2: Intestatari -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="NOME" FontSize="9" TextColor="#FDE68A" FontAttributes="Bold" />
                                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="8,0" HeightRequest="36">
                                                <Entry Text="{Binding CardHolderName}" Placeholder="Mario" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" FontSize="13" VerticalOptions="Center"/>
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="COGNOME" FontSize="9" TextColor="#FDE68A" FontAttributes="Bold" />
                                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="8,0" HeightRequest="36">
                                                <Entry Text="{Binding CardHolderSurname}" Placeholder="Rossi" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" FontSize="13" VerticalOptions="Center"/>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- RIGA 3: Numero Carta in 4 Blocchi -->
                                    <VerticalStackLayout Grid.Row="2">
                                        <Label Text="NUMERO CARTA" FontSize="9" TextColor="#FDE68A" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0" HeightRequest="36">
                                                <Entry Text="{Binding CardNumberPart1}" MaxLength="4" Keyboard="Numeric" Placeholder="0000" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" FontSize="13" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="1" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0" HeightRequest="36">
                                                <Entry Text="{Binding CardNumberPart2}" MaxLength="4" Keyboard="Numeric" Placeholder="0000" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" FontSize="13" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="2" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0" HeightRequest="36">
                                                <Entry Text="{Binding CardNumberPart3}" MaxLength="4" Keyboard="Numeric" Placeholder="0000" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" FontSize="13" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="3" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0" HeightRequest="36">
                                                <Entry Text="{Binding CardNumberPart4}" MaxLength="4" Keyboard="Numeric" Placeholder="0000" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" FontSize="13" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- RIGA 4: Scadenza (MM e AA Spaziati e Non Tagliati) e CVV -->
                                    <Grid Grid.Row="3" ColumnDefinitions="Auto, 50, 50, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="SCADENZA:" TextColor="#FDE68A" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>

                                        <!-- Box Mese (MM) -->
                                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="38" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0">
                                            <Entry Text="{Binding ExpiryMonth}" MaxLength="2" Keyboard="Numeric" Placeholder="MM" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="13" Margin="0" />
                                        </Border>

                                        <!-- Box Anno (AA) -->
                                        <Border Grid.Column="2" WidthRequest="48" HeightRequest="38" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0">
                                            <Entry Text="{Binding ExpiryYear}" MaxLength="2" Keyboard="Numeric" Placeholder="AA" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="13" Margin="0" />
                                        </Border>

                                        <!-- Box CVV -->
                                        <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
                                            <Label Text="CVV:" TextColor="#FDE68A" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Border WidthRequest="52" HeightRequest="38" StrokeShape="RoundRectangle 8" BackgroundColor="#25000000" StrokeThickness="0" Padding="2,0">
                                                <Entry Text="{Binding Cvv}" MaxLength="3" Keyboard="Numeric" IsPassword="True" Placeholder="•••" PlaceholderColor="#FDE68A" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="13" Margin="0" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- PULSANTE SALVA CARTA -->
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="48" Margin="0,4,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#5B21B6" Offset="0.0" />
                                        <GradientStop Color="#2563EB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Button Text="Salva Metodo di Pagamento" Command="{Binding SaveCreditCardCommand}" BackgroundColor="Transparent" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14"/>
                            </Border>

                            <!-- AVVISO DI SICUREZZA -->
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Padding="4,4">
                                <Label Grid.Column="0" Text="🔒" FontSize="14" VerticalOptions="Start" Margin="0,2,0,0"/>
                                <Label Grid.Column="1"
                                       Text="I dati inseriti sono protetti da crittografia end-to-end e trattati in piena conformità con gli standard di sicurezza PCI-DSS. Didattiko non memorizza il codice di sicurezza (CVV) né il numero completo della tua carta su server non protetti."
                                       FontSize="11"
                                       TextColor="#E2E8F0"
                                       LineHeight="1.2" />
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. SEZIONE AZIONI: COMPRA E VENDI LIBRI (Stesso stile dell'header) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">

                    <!-- CARD COMPRA LIBRI -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 22"
                            Stroke="#40FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#20FFFFFF"
                            Padding="16,22"
                            HeightRequest="175">
                        <Border.Shadow>
                            <Shadow Brush="#30000000" Offset="0,6" Radius="12" Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToBuyBooksCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                            <!-- Emoji più grande con cerchio soft -->
                            <Border WidthRequest="68" HeightRequest="68" StrokeShape="RoundRectangle 34" BackgroundColor="#25FFFFFF" StrokeThickness="0" HorizontalOptions="Center">
                                <Label Text="📚" FontSize="42" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Text="COMPRA&#10;LIBRI"
                                   HorizontalTextAlignment="Center"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   LineHeight="1.1" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD VENDI LIBRI -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 22"
                            Stroke="#40FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#20FFFFFF"
                            Padding="16,22"
                            HeightRequest="175">
                        <Border.Shadow>
                            <Shadow Brush="#30000000" Offset="0,6" Radius="12" Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSellBooksCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                            <!-- Emoji più grande con cerchio soft -->
                            <Border WidthRequest="68" HeightRequest="68" StrokeShape="RoundRectangle 34" BackgroundColor="#25FFFFFF" StrokeThickness="0" HorizontalOptions="Center">
                                <Label Text="📦" FontSize="42" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Text="VENDI&#10;LIBRI"
                                   HorizontalTextAlignment="Center"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   LineHeight="1.1" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 4. BANNER ORDINI / AGGIORNAMENTO -->
                <Border StrokeShape="RoundRectangle 18"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#15FFFFFF"
                        Padding="16,14">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="✨" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Tracciamento Spedizioni e Ordini" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold"/>
                            <Label Text="Disponibile nel prossimo aggiornamento dell'Hub." TextColor="#CBD5E1" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 5. PULSANTE IN BASSO: TORNA AL LOGIN -->
                <Border StrokeShape="RoundRectangle 14"
                        Stroke="#40FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF"
                        HeightRequest="48"
                        Margin="0,10,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#30000000" Offset="0,4" Radius="8" Opacity="0.4" />
                    </Border.Shadow>

                    <Button Text="Torna al Login"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#FFFFFF"
                            FontSize="14"
                            FontAttributes="Bold" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>