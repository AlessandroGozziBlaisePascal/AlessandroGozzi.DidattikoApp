<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AlessandroGozzi.BookECommerce.MobileGUI.ViewModels"
             x:Class="AlessandroGozzi.BookECommerce.MobileGUI.Pages.PasswordResetPage"
             x:DataType="vm:PasswordResetViewModel"
             Shell.NavBarIsVisible="False">

    <Grid IgnoreSafeArea="True">
        <!-- Sfondo a Gradiente Viola - Indaco - Blu -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4A148C" Offset="0.0" />
                <GradientStop Color="#5B21B6" Offset="0.35" />
                <GradientStop Color="#1D4ED8" Offset="0.75" />
                <GradientStop Color="#2563EB" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="20"
                                 Padding="20,50,20,35"
                                 VerticalOptions="Center">

                <!-- Header: Tasto Back Circolare Glass + Titolo Badge -->
                <Border Grid.Column="1"
        StrokeShape="RoundRectangle 18"
        Stroke="#60FFFFFF"
        StrokeThickness="1.5"
        BackgroundColor="#25FFFFFF"
        Padding="24,10"
        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#30000000" Offset="0,6" Radius="12" Opacity="0.5" />
                    </Border.Shadow>

                    <Label Text="RESET PASSWORD"
           FontSize="17"
           FontAttributes="Bold"
           TextColor="#FFFFFF"
           CharacterSpacing="2"
           HorizontalOptions="Center" />
                </Border>

                <!-- CARD 1: Fase 1 (Richiesta Codice OTP) -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#E2E8F0"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        Padding="22,24"
                        MaximumWidthRequest="430"
                        HorizontalOptions="Fill">

                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,8" Radius="18" Opacity="0.55" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Fase 1: Richiesta Codice"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />

                        <Label Text="Email o Numero di telefono"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#475569" />

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                            <Entry Placeholder="Inserisci recapito" PlaceholderColor="#94A3B8" TextColor="#0F172A" Text="{Binding Recapito}" VerticalOptions="Center" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="46" Margin="0,4,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5B21B6" Offset="0.0" />
                                    <GradientStop Color="#2563EB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="Invia Codice OTP" Command="{Binding RequestOtpCommand}" BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </Border>

                        <Label Text="Riceverai un codice OTP da inserire nel modulo sottostante." FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- CARD 2: Fase 2 (Imposta Nuova Password) -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#E2E8F0"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        Padding="22,24"
                        MaximumWidthRequest="430"
                        HorizontalOptions="Fill"
                        IsEnabled="{Binding IsPhase2Enabled}"
                        Opacity="{Binding Phase2Opacity}">

                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,8" Radius="18" Opacity="0.55" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Fase 2: Nuova Password"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0" HeightRequest="46">
                            <Entry Placeholder="Codice OTP ricevuto" Keyboard="Numeric" PlaceholderColor="#94A3B8" TextColor="#0F172A" Text="{Binding CodiceOtp}" VerticalOptions="Center" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0" HeightRequest="46">
                            <Entry Placeholder="Nuova password" IsPassword="True" PlaceholderColor="#94A3B8" TextColor="#0F172A" Text="{Binding NewPassword}" VerticalOptions="Center" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0" HeightRequest="46">
                            <Entry Placeholder="Conferma password" IsPassword="True" PlaceholderColor="#94A3B8" TextColor="#0F172A" Text="{Binding ConfirmPassword}" VerticalOptions="Center" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="46" Margin="0,4,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1D4ED8" Offset="0.0" />
                                    <GradientStop Color="#2563EB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="Conferma Nuova Password" Command="{Binding ExecutePasswordResetCommand}" BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Tasto Outlined Indietro in Fondo allo Scroll -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="#60FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#20FFFFFF"
                        HeightRequest="44"
                        MaximumWidthRequest="430"
                        HorizontalOptions="Fill">
                    <Button Text="Torna al Login"
                            Command="{Binding BackToLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#FFFFFF"
                            FontSize="13"
                            FontAttributes="Bold" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>