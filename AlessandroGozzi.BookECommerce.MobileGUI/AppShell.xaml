<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AlessandroGozzi.BookECommerce.MobileGUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AlessandroGozzi.BookECommerce.MobileGUI.Pages"
    Title="AlessandroGozzi.BookECommerce.MobileGUI">

    <!-- 1. PAGINA DI AVVIO: IntroPage (eseguita per prima) -->
    <ShellContent
        Title="Intro"
        Route="IntroPage"
        ContentTemplate="{DataTemplate views:IntroPage}" />

    <!-- 2. Pagina di Login (raggiunta dopo l'animazione) -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- 3. Altre rotte globali -->
    <ShellContent
        Title="Registration"
        Route="RegistrationPage"
        ContentTemplate="{DataTemplate views:RegistrationPage}" />

    <ShellContent
        Title="PasswordReset"
        Route="PasswordResetPage"
        ContentTemplate="{DataTemplate views:PasswordResetPage}" />

    <ShellContent
    Title="Principal"
    Route="PrincipalPage"
    ContentTemplate="{DataTemplate views:PrincipalPage}" />

</Shell>
