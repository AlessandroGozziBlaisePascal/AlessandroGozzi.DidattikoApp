    <ProjectReference Include="..\AlessandroGozzi.BookECommerce.Infrastructure\AlessandroGozzi.BookECommerce.Infrastructure.csproj" />
    <ProjectReference Include="..\AlessandroGozzi.BookECommerce.SharedKernel\AlessandroGozzi.BookECommerce.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Immagini\CompraLibri.png" />
    <Resource Include="Immagini\LogoDidattiko.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Immagini\SfondoLegnoChiaroWPF.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Immagini\SfondoLegnoWPF.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Immagini\VendiLibri.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
