<Window x:Class="AlessandroGozzi.BookECommerce.WPF.PrincipalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Used Book Co." 
        Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF8DC"/>
            <Setter Property="Foreground" Value="#2B1609"/>
            <Setter Property="BorderBrush" Value="#8B5A2B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile Neutro / Schiarito per la Carta -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B4513"/>
            <Setter Property="Foreground" Value="#FFF8DC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#DAA520"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#A0522D"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#5C2E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" 
            BorderBrush="#2B1609" 
            BorderThickness="4"
            Margin="10"
            MouseLeftButtonDown="Window_MouseDown">

        <Border.Background>
            <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="Fill"/>
        </Border.Background>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    CornerRadius="12" 
                    Margin="5,0,5,10"
                    ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid VerticalAlignment="Stretch" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0,15,0">
                        <TextBlock Text="Benvenuto" 
                                   FontFamily="Brush Script MT, Segoe Script, Cursive" 
                                   FontSize="80" 
                                   Foreground="#3A210A"/>
                        <TextBlock Text="{Binding CustomerFullName}" 
                           FontWeight="Bold" 
                           FontSize="42" 
                           TextTrimming="CharacterEllipsis"
                           Foreground="#2B1609" 
                           Margin="0,-10,0,0"/> 
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Background="#B8860B" 
                            CornerRadius="14" 
                            Padding="12" 
                            Height="165"
                            ClipToBounds="True"
                            VerticalAlignment="Center">

                        <Grid>
                            <Path Data="M -20,120 C 80,40 200,180 360,30" 
                                  Stroke="#E6C280" 
                                  StrokeThickness="18" 
                                  Opacity="0.45" 
                                  IsHitTestVisible="False"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Owner" Foreground="#2B1609" FontWeight="Bold" FontSize="11" Margin="2,0,0,2"/>
                                <TextBox Text="{Binding CardOwner, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCardEditable}"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         Height="30" 
                                         FontSize="13" 
                                         Padding="6,0"
                                         Margin="0,0,0,6"/>

                                <TextBlock Text="Card Number" Foreground="#2B1609" FontWeight="Bold" FontSize="11" Margin="2,0,0,2"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding CardNumber1, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Style="{StaticResource RoundedTextBoxStyle}" Height="30" TextAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="2" Text="{Binding CardNumber2, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Style="{StaticResource RoundedTextBoxStyle}" Height="30" TextAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="4" Text="{Binding CardNumber3, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Style="{StaticResource RoundedTextBoxStyle}" Height="30" TextAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="6" Text="{Binding CardNumber4, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Style="{StaticResource RoundedTextBoxStyle}" Height="30" TextAlignment="Center" FontSize="13"/>
                                </Grid>

                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pulsante ridimensionato e leggibile -->
                                    <Button Grid.Column="0" 
                                        Command="{Binding CardActionCommand}"
                                        Content="{Binding CardActionButtonText}" 
                                        Style="{StaticResource NeutralButtonStyle}" 
                                        Cursor="Hand"
                                        Height="28"
                                        Margin="0,0,4,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Expiry" Foreground="#2B1609" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox Text="{Binding ExpiryMonth, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Width="32" Height="26" Style="{StaticResource RoundedTextBoxStyle}" TextAlignment="Center" FontSize="11"/>
                                        <TextBlock Text="/" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#2B1609" 
                                                   Margin="1,0,1,0" 
                                                   VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ExpiryYear, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCardEditable}" Width="32" Height="26" Style="{StaticResource RoundedTextBoxStyle}" TextAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="5,5,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="16" 
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="Fill"/>
                                </Border.Background>

                                <Image Source="/Immagini/CompraLibri.png" 
                                       Stretch="UniformToFill" 
                                       Margin="-70"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="16" 
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="Fill"/>
                                </Border.Background>

                                <Image Source="/Immagini/VendiLibri.png" 
                                       Stretch="UniformToFill" 
                                       Margin="-55"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>