<Window x:Class="AlessandroGozzi.BookECommerce.WPF.PrincipalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
        Title="Home Dashboard - Used Book Co." 
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- SFONDO GENERALE -->
        <Grid.Background>
            <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- Header in alto -->
            <RowDefinition Height="160"/>
            <!-- Contenuto principale -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER SUPERIORE CON SFONDO LEGNO CHIARO -->
        <Border Grid.Row="0" CornerRadius="18" Margin="20,15,20,5" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid Margin="25,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icona Profilo -->
                <Image Grid.Column="0" Source="/Immagini/FotoProfiloDefault.png" Width="110" Height="110" VerticalAlignment="Center"/>

                <!-- Messaggio di Benvenuto -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Foreground="#3A2213" FontSize="34" FontWeight="Bold" FontFamily="Segoe UI" TextAlignment="Center">
                        <Run Text="Benvenuto, "/>
                        <Run Text="{Binding CurrentCustomer.FullName, FallbackValue='ALESSANDRO GOZZI'}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Pulsante Aggiungi Credit Card -->
                <Button Grid.Column="2" Width="210" Height="75" Cursor="Hand" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Click="BtnAddCreditCard_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#F4F1E8" CornerRadius="14" BorderThickness="0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="+ Aggiungi" Foreground="#3A2213" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Credit Card" Foreground="#3A2213" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 2. AREA CENTRALE: IMMAGINI APPLICATE DIRETTAMENTE COME BACKGROUND -->
        <Grid Grid.Row="1" Margin="30,10,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BOTTONE 1: COMPRA LIBRI -->
            <Button Grid.Column="0" Width="460" Height="436" Cursor="Hand" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnCompraLibri_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="24" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="/Immagini/CompraLibri.png" Stretch="Fill"/>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- BOTTONE 2: VENDI LIBRI -->
            <Button Grid.Column="2" Width="460" Height="436" Cursor="Hand" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnVendiLibri_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="24" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="/Immagini/VendiLibri.png" Stretch="Fill"/>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>