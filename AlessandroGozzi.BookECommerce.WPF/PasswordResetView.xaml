<Window x:Class="AlessandroGozzi.BookECommerce.WPF.PasswordResetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recupero Password - Used Book Co." Height="600" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5B8C32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4A7528"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#A8BFA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#1A000000">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="📚 Recupero Password - Used Book Co." Foreground="#FFD2A8" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="—" Foreground="White" Background="Transparent" BorderThickness="0" Width="30"/>
                        <Button Content="☐" Foreground="White" Background="Transparent" BorderThickness="0" Width="30"/>
                        <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" Width="30" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="8" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <Border CornerRadius="15" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Border.Background>
                            <Image Margin="30" Stretch="Uniform"/>
                        </Border>
                    </Border>

                    <Border Grid.Column="1" Margin="8" Background="#FFFBF3" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="22,20" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Fase 1: Verifica Codice" FontSize="26" FontWeight="Bold" Foreground="#8B3A0F" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Button Grid.Row="1" x:Name="BtnInviaCodice" Content="Invia codice" Style="{StaticResource GreenButtonStyle}" Click="BtnInviaCodice_Click" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" x:Name="TxtAvviso" Foreground="#555555" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,15"
                                       Text="Il codice di verifica OTP verrà inviato al tuo recapito. In caso di mancata ricezione, cliccare nuovamente su 'Invia codice'."/>

                            <TextBlock Grid.Row="3" Text="Inserisci codice OTP" FontSize="16" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                            <TextBox Grid.Row="4" x:Name="TxtCodiceOtp" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,15"/>

                            <Button Grid.Row="5" x:Name="BtnConfermaCodice" Content="Conferma codice" Style="{StaticResource GreenButtonStyle}" Click="BtnConfermaCodice_Click"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PannelloFase2" Grid.Column="2" Margin="8" Background="#FFFBF3" CornerRadius="15" IsEnabled="False" Opacity="0.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="22,20" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Fase 2: Nuova Password" FontSize="26" FontWeight="Bold" Foreground="#8B3A0F" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <TextBlock Grid.Row="1" Text="Nuova password" FontSize="16" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                            <PasswordBox Grid.Row="2" Style="{StaticResource CustomPasswordBoxStyle}" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="3" Text="Conferma password" FontSize="16" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                            <PasswordBox Grid.Row="4" Style="{StaticResource CustomPasswordBoxStyle}" Margin="0,0,0,20"/>

                            <Button Grid.Row="5" Content="Conferma" Style="{StaticResource GreenButtonStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>