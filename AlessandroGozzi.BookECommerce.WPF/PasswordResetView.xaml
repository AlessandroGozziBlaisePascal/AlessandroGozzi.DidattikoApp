<Window x:Class="AlessandroGozzi.BookECommerce.WPF.PasswordResetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recupero Password - Used Book Co." Height="650" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5B8C32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4A7528"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#A8BFA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLONNA SINISTRA: Titolo + Logo -->
                    <Grid Grid.Column="0" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Scheda Superiore -->
                        <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Border CornerRadius="15" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="RESET&#10;PASSWORD" FontSize="32" FontWeight="Bold" 
                                               Foreground="#5C260B" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="36"/>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Scheda Inferiore -->
                        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Border CornerRadius="15" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Image Source="/Immagini/LogoDidattiko.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- COLONNA CENTRALE: Fase 1 (Solo Invio OTP) -->
                    <Border Grid.Column="1" Margin="8" Background="#FFFBF3" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="22,15" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Fase 1: Richiesta Codice" FontSize="22" FontWeight="Bold" Foreground="#8B3A0F" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Text="Email o Numero di telefono" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="2" x:Name="TxtRecapito" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,15"/>

                            <Button Grid.Row="3" x:Name="BtnInviaCodice" Content="Invia codice" Style="{StaticResource GreenButtonStyle}" Click="BtnInviaCodice_Click" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="4" x:Name="TxtAvviso" Foreground="#555555" FontSize="12" TextWrapping="Wrap" LineHeight="16"
                                       Text="Il codice OTP verrà inviato al recapito inserito. Una volta inviato, potrai completare la procedura nella colonna di destra."/>
                        </Grid>
                    </Border>

                    <!-- COLONNA DESTRA: Fase 2 (OTP + Nuova Password) -->
                    <Border x:Name="PannelloFase2" Grid.Column="2" Margin="8" Background="#FFFBF3" CornerRadius="15" IsEnabled="False" Opacity="0.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="22,15" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Fase 2: Reset Password" FontSize="22" FontWeight="Bold" Foreground="#8B3A0F" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="Codice OTP ricevuto" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="2" x:Name="TxtCodiceOtp" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Text="Nuova password" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                            <PasswordBox Grid.Row="4" x:Name="TxtNewPassword" Style="{StaticResource CustomPasswordBoxStyle}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="5" Text="Conferma password" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                            <PasswordBox Grid.Row="6" x:Name="TxtConfirmPassword" Style="{StaticResource CustomPasswordBoxStyle}" Margin="0,0,0,15"/>

                            <Button Grid.Row="7" x:Name="BtnResetPassword" Content="Conferma Reset" Style="{StaticResource GreenButtonStyle}" Click="BtnResetPassword_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>