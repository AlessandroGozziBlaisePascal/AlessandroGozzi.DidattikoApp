<Window x:Class="AlessandroGozzi.BookECommerce.WPF.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACCEDI - Used Book Co." Height="600" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="#9E8C77" FontSize="18"
                                           VerticalAlignment="Center" Margin="17,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WatermarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="#9E8C77" FontSize="18"
                                           VerticalAlignment="Center" Margin="17,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Password, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#1A000000">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="📚 ACCEDI - Used Book Co." Foreground="#FFD2A8" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="—" Foreground="White" Background="Transparent" BorderThickness="0" Width="30"/>
                        <Button Content="☐" Foreground="White" Background="Transparent" BorderThickness="0" Width="30"/>
                        <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" Width="30"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <Border CornerRadius="15" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Border.Background>
                            <Image Margin="40" Stretch="Uniform"/>
                        </Border>
                    </Border>

                    <Border Grid.Column="1" Margin="10" Background="#FFFBF3" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="30,20" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ACCEDI" FontSize="42" FontWeight="Bold" 
                                       Foreground="#8B3A0F" Margin="0,0,0,25" HorizontalAlignment="Left"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                                <TextBlock Text="Email o Numero di telefono" FontSize="14" FontWeight="SemiBold" Foreground="#6A4E38" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Inserisci email o numero"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,5">
                                <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" Foreground="#6A4E38" Margin="0,0,0,6"/>
                                <PasswordBox Style="{StaticResource WatermarkPasswordBox}" Tag="Inserisci password"/>
                            </StackPanel>

                            <Button Grid.Row="3" Content="Password dimenticata?" Background="Transparent" Foreground="#B34A12" 
                                    BorderThickness="0" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" 
                                    Cursor="Hand" Margin="0,4,0,30"/>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Non hai un account? " Foreground="#555555" FontSize="15"/>
                                <Button Content="Registrati" Background="Transparent" BorderThickness="0" Foreground="#B34A12" FontWeight="Bold" FontSize="15" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,10" Background="#FFFBF3" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <Image Margin="10" Stretch="Uniform"/>
                        </Border>

                        <Border Grid.Row="1" Margin="0,10,0,0" Background="#FFFBF3" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <Image Margin="10" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>