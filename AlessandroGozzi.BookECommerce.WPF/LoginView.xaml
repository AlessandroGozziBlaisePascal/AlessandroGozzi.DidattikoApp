<Window x:Class="AlessandroGozzi.BookECommerce.WPF.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACCEDI - Used Book Co." Height="600" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Stile TextBox con Watermark -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="#9E8C77" FontSize="18"
                                           VerticalAlignment="Center" Margin="17,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile PasswordBox Corretto (Watermark dinamico con EventTrigger) -->
        <Style x:Key="WatermarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#EFE4D3"/>
            <Setter Property="BorderBrush" Value="#D6C4AD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="WatermarkText" Text="{TemplateBinding Tag}" Foreground="#9E8C77" FontSize="18"
                                           VerticalAlignment="Center" Margin="17,0" IsHitTestVisible="False" Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Nasconde la scritta appena il campo riceve focus o contiene caratteri -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile Pulsante Verde principale -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5B8C32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4A7528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Immagini/SfondoLegnoWPF.jpg" Stretch="UniformToFill"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLONNA SINISTRA -->
                    <Grid Grid.Column="0" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Scheda Superiore: LOGIN -->
                        <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Border CornerRadius="15" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="LOGIN" FontSize="45" FontWeight="Bold" 
                                               Foreground="#5C260B" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Scheda Inferiore: Logo a tutto spazio -->
                        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Border.Background>
                                <ImageBrush ImageSource="/Immagini/SfondoLegnoChiaroWPF.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                            <Image Source="/Immagini/LogoDidattiko.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- COLONNA CENTRALE: Form di Login -->
                    <Border Grid.Column="1" Margin="10" Background="#FFFBF3" CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Grid Margin="30,20" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ACCEDI" FontSize="42" FontWeight="Bold" 
                                       Foreground="#8B3A0F" Margin="0,0,0,20" HorizontalAlignment="Left"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <TextBlock Text="Email o Numero di telefono" FontSize="14" FontWeight="SemiBold" Foreground="#6A4E38" Margin="0,0,0,6"/>
                                <TextBox x:Name="IdentifierTextBox" Style="{StaticResource WatermarkTextBox}" Tag="Inserisci email o numero"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" Foreground="#6A4E38" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="PasswordTextBox" Style="{StaticResource WatermarkPasswordBox}" Tag="Inserisci password"/>
                            </StackPanel>

                            <!-- Bottone Accedi -->
                            <Button Grid.Row="3" x:Name="BtnLogin" Content="Accedi" Style="{StaticResource GreenButtonStyle}" Margin="0,0,0,8" Click="BtnLogin_Click"/>

                            <Button Grid.Row="4" Content="Password dimenticata?" Background="Transparent" Foreground="#B34A12" 
                                    BorderThickness="0" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" 
                                    Cursor="Hand" Margin="0,0,0,20" Click="BtnForgotPassword_Click"/>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Non hai un account? " Foreground="#555555" FontSize="15"/>
                                <Button Content="Registrati" Background="Transparent" BorderThickness="0" Foreground="#B34A12" FontWeight="Bold" FontSize="15" Cursor="Hand" Click="BtnRegister_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- COLONNA DESTRA: Quadrati Top Secret / Locked -->
                    <Grid Grid.Column="2" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Box Superiore Top Secret -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Background="#1E1916" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Rectangle Stroke="#8B3A0F" StrokeThickness="2" StrokeDashArray="4 2" Margin="8" RadiusX="8" RadiusY="8"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,5" Opacity="0.8"/>
                                    <Border BorderBrush="#C0392B" BorderThickness="2" Background="#2C0000" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-8"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="NOT IMPLEMENTED" Foreground="#E74C3C" FontWeight="Black" FontSize="13"/>
                                    </Border>
                                    <TextBlock Text="AREA RISERVATA" Foreground="#8A7B70" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Box Inferiore Top Secret -->
                        <Border Grid.Row="1" Margin="0,10,0,0" Background="#1E1916" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Rectangle Stroke="#8B3A0F" StrokeThickness="2" StrokeDashArray="4 2" Margin="8" RadiusX="8" RadiusY="8"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,5" Opacity="0.8"/>
                                    <Border BorderBrush="#C0392B" BorderThickness="2" Background="#2C0000" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="6"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="NOT IMPLEMENTED" Foreground="#E74C3C" FontWeight="Black" FontSize="13"/>
                                    </Border>
                                    <TextBlock Text="IN ARRIVO" Foreground="#8A7B70" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>